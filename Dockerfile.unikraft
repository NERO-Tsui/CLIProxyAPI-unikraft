# syntax=docker/dockerfile:1
#
# Image used to deploy CLIProxyAPI as a unikernel on Unikraft Cloud.
# Built by .github/workflows/unikraft-deploy.yml via `unikraft build`,
# using this file as the Dockerfile of the build context.
#
# Differences from the stock Dockerfile:
# - CGO is disabled to produce a fully static binary (the Unikraft Cloud
#   unikernel runtime has no dynamic loader; plugin support is disabled
#   accordingly, which matches the default configuration).
# - Alpine is used instead of Debian to keep the unikernel rootfs minimal.
# - The entrypoint seeds the configuration on the persistent volume mounted
#   at /data before starting the server.

FROM golang:1.26-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./

RUN go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_DATE=unknown

RUN CGO_ENABLED=0 GOOS=linux go build -buildvcs=false \
    -ldflags="-s -w -X 'main.Version=${VERSION}' -X 'main.Commit=${COMMIT}' -X 'main.BuildDate=${BUILD_DATE}'" \
    -o /out/CLIProxyAPI ./cmd/server/

FROM alpine:3

RUN apk add --no-cache ca-certificates tzdata \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

RUN mkdir -p /CLIProxyAPI

COPY --from=builder /out/CLIProxyAPI /CLIProxyAPI/CLIProxyAPI
COPY config.example.yaml /CLIProxyAPI/config.example.yaml
COPY unikraft-entrypoint.sh /CLIProxyAPI/unikraft-entrypoint.sh
RUN chmod 0755 /CLIProxyAPI/unikraft-entrypoint.sh

WORKDIR /CLIProxyAPI

EXPOSE 8317

ENV TZ=Asia/Shanghai

# /data is the mount point of the persistent Unikraft Cloud volume attached
# by the deploy workflow. Configuration, credentials and writable state
# must live there because the unikernel root filesystem is read-only.
ENTRYPOINT ["/CLIProxyAPI/unikraft-entrypoint.sh"]
