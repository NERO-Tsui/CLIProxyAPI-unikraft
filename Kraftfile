# Unikraft Cloud build specification for CLIProxyAPI.
#
# Used by `unikraft build` (see .github/workflows/unikraft-deploy.yml).
# The root filesystem is produced by Dockerfile.unikraft and packaged
# as a read-only EROFS image; the base-compat runtime boots it as a
# unikernel. /data is backed by a persistent Unikraft Cloud volume.

spec: v0.7

runtime: base-compat:latest

targets:
  - kraftcloud/x86_64

rootfs:
  source: ./Dockerfile.unikraft
  format: erofs

cmd: ["/CLIProxyAPI/unikraft-entrypoint.sh"]
